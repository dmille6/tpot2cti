# tpot2cti — environment configuration template
# Copy to .env and fill in. `setup.sh` does this automatically.
# Full reference: V1_SPEC.md §10 + docs/CONFIGURATION.md (post-impl)

# === T-Pot connection ===
TPOT_HOST=
TPOT_SSH_USER=tpot
TPOT_SSH_PORT=64295

# === Operator identity ===
OPERATOR_ORG_NAME=T-Pot Operator
TPOT2CTI_DEFAULT_TLP=AMBER+STRICT
TPOT2CTI_DEFAULT_CONFIDENCE=75

# === Cycle behavior ===
TPOT2CTI_INTERVAL=PT15M
TPOT2CTI_INITIAL_LOOKBACK_HOURS=0
TPOT2CTI_IGNORE_TYPES=

# === OpenCTI connection (shared with opencti/.env) ===
# setup.sh fills both sides with the same generated value
OPENCTI_URL=http://opencti:8080
OPENCTI_ADMIN_TOKEN=

# === Connector UUIDs (auto-generated by setup.sh) ===
TPOT2CTI_CONNECTOR_ID=
TPOT2CTI_CREDENTIALS_CONNECTOR_ID=
TPOT2CTI_VAULT_CONNECTOR_ID=

# === Logging ===
LOG_LEVEL=INFO

# === Optional feature toggles (compose profiles) ===
# COMPOSE_PROFILES=credentials,vault
