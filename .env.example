# tpot2cti — environment configuration template (V1_SPEC §10).
# Copy this to `.env` and fill in.  `setup.sh` populates the blanks
# automatically by generating secrets, reading opencti/.env, and
# minting connector UUIDs.
#
# Every var here is read by tpot2cti/config.py at startup, or by
# tpot2cti/main.py (TPOT2CTI_HEALTH_BIND, TPOT2CTI_STATE_DB), or by
# tpot-tunnel/entrypoint.sh (TPOT_HOST + TPOT_SSH_*).
#
# Per LESSONS_LEARNED §9.2: compose MUST be invoked with
# `--env-file ./.env` if you ever override --project-directory.

# ===========================================================================
# Required — T-Pot connection
# ===========================================================================
# Hostname or IP of the T-Pot honeypot node.  Reachable from this host
# over SSH on TPOT_SSH_PORT.
TPOT_HOST=

# SSH user on the T-Pot host (T-Pot ships `tpot` by default).
TPOT_SSH_USER=tpot

# SSH port T-Pot listens on.  Default upstream is 64295.
TPOT_SSH_PORT=64295

# Comma-separated list of "infrastructure" IPs that should be silently
# filtered as src_ip — events from these are NOT attacker activity.
# Include:
#   1. OUR honeypot's public IPs. Our server appears as a "source" in
#      Suricata's bidirectional view of traffic (e.g. H0neytr4p serves
#      deceptive `Host: www.google.com` HTML → Suricata logs the
#      honeypot IP as src_ip with that http.hostname). Without this
#      filter, we'd ingest our own server as an "attacker."
#   2. Any T-Pot HIVE coordinator IP if you're running a hive
#      architecture. Hive→sensor management traffic also shows up as
#      Suricata alerts. Adding the hive here is the right call —
#      attackers don't connect from the management plane.
#   3. Bastion / jumphost IPs from which YOUR team SSH'es into the
#      sensor. Same reason.
# IMPORTANT: include EVERY public IP your T-Pot fronts (v4 + v6) so the
# filter catches both stacks. Empty = filter disabled.
TPOT_HONEYPOT_IPS=

# ===========================================================================
# Tunnel — used by the tpot-tunnel sidecar (entrypoint.sh)
# ===========================================================================
# Remote port on T-Pot where Elasticsearch listens (loopback).  64298
# is T-Pot's default for ES.
TPOT_ES_REMOTE_PORT=64298

# Where autossh listens inside the tunnel container.  The importer
# connects to this over the opencti_default network as tunnel:9200.
# Almost never needs changing.
TUNNEL_LOCAL_BIND=0.0.0.0:64298

# autossh tuning — start immediately (gatetime=0), probe every 60s.
AUTOSSH_GATETIME=0
AUTOSSH_POLL=60

# ===========================================================================
# T-Pot Elasticsearch (via tunnel) — defaults match the tunnel sidecar
# ===========================================================================
# Hostname inside the docker network.  Default `tunnel` matches the
# compose service key for the autossh sidecar.
ES_HOST=tunnel

# Port the importer connects to (matches TUNNEL_LOCAL_BIND's port).
ES_PORT=64298

# http|https.  The tunnel itself is encrypted by SSH, so http is fine
# end-to-end (and matches T-Pot's default ES config inside the tunnel).
ES_SCHEME=http

# Optional ES basic-auth credentials.  T-Pot's default install has ES
# unauthenticated on loopback; leave blank unless you've enabled auth.
ES_USERNAME=
ES_PASSWORD=

# Validate ES server cert (only meaningful with ES_SCHEME=https).
ES_VERIFY_CERTS=false

# Index pattern matching T-Pot's logstash output.
ES_INDEX_PATTERN=logstash-*

# Per-request ES timeout (seconds).  Bump for very slow networks.
ES_REQUEST_TIMEOUT=30

# ===========================================================================
# OpenCTI connection — shared with opencti/.env
# ===========================================================================
# Internal docker network URL for the OpenCTI API.  Don't change
# unless you've also reconfigured OpenCTI's compose.
OPENCTI_URL=http://opencti:8080

# OpenCTI admin token.  setup.sh writes the SAME value into both this
# file and opencti/.env.  If you rotate it, you must update both.
OPENCTI_ADMIN_TOKEN=

# ===========================================================================
# Per-connector UUIDs — generated by setup.sh, pinned across restarts
# ===========================================================================
# Each compose service registers with OpenCTI under its own UUID.
# Per LESSONS_LEARNED §8.2: an empty CONNECTOR_ID produces
# BAD_USER_INPUT — config.py refuses to start in that case.
TPOT2CTI_CONNECTOR_ID=
TPOT2CTI_CREDENTIALS_CONNECTOR_ID=
TPOT2CTI_VAULT_CONNECTOR_ID=

# ===========================================================================
# Operator identity — stamped on every emitted STIX object
# ===========================================================================
# Human-readable name of the org running this importer.  Appears as
# the STIX Identity (object_marking_refs source).
OPERATOR_ORG_NAME=T-Pot Operator

# Default TLP marking for emitted STIX.  One of:
# CLEAR / GREEN / AMBER / AMBER+STRICT / RED.
TPOT2CTI_DEFAULT_TLP=AMBER+STRICT

# Default confidence (0-100) on emitted SDOs and relationships.
TPOT2CTI_DEFAULT_CONFIDENCE=75

# ===========================================================================
# Cycle behavior (V1_SPEC §3)
# ===========================================================================
# Cycle interval as ISO 8601 duration.  PT15M = 15 minutes.
TPOT2CTI_INTERVAL=PT15M

# Initial backfill window on first run.  0 = start fresh from "now"
# (v1.0 default).  Positive integer = hours of history to pull.
TPOT2CTI_INITIAL_LOOKBACK_HOURS=0

# Comma-separated honeypot `type` values to skip entirely at the ES
# query layer (before parsing). The default ignores:
#   P0f — passive OS-fingerprint enrichment; volume ~2.3M events/day
#         at fleet scale; PoC LESSONS §31 "two-question rule" places it
#         firmly in the enrichment camp, not the bulk-import loop.
#   ssh-rsa — T-Pot logstash re-types Cowrie `cowrie.client.fingerprint`
#         sub-events as type=ssh-rsa. The actual session data is already
#         captured by the Cowrie parser via type=Cowrie; treating these
#         as a separate honeypot would emit duplicate Indicators.
# Remove either default if you have a specific need to ingest those events.
# Add other types here as your operations require, comma-separated.
TPOT2CTI_IGNORE_TYPES=P0f,ssh-rsa

# Max ES docs fetched per scroll page.
TPOT2CTI_BATCH_SIZE=1000

# Seconds the publisher sleeps between its three passes (Foundation →
# Entities → Relationships). Per PoC HP_CONNECTOR_HANDOFF §4 this is
# "the single most impactful tuning parameter" — too low and pass-2
# lands before pass-1 finishes indexing in OpenCTI (MISSING_REFERENCE
# errors); too high and the cycle overruns the interval.
#   60   single-sensor (default; good for first install)
#   120  small fleet (2-3 sensors)
#   300  hive scale (5+ sensors) — matches PoC production setting
# Watch the cycle summary log for "cycle overrun" warnings — that's
# the signal to raise this.
TPOT2CTI_INDEXING_DELAY_SECONDS=60

# FATT (passive TLS/SSH fingerprint) cadence multiplier. With the PoC
# pattern, FATT runs at PT60M while honeypots run at PT15M because
# fingerprints are slowly-evolving passive observations. Set this to
# (PT60M / TPOT2CTI_INTERVAL); default 4 means "FATT every 4th cycle."
# Set to 1 to process FATT every cycle (matches pre-2026-05-21 behavior).
TPOT2CTI_FATT_CYCLE_MULTIPLIER=4

# If set (0-23), the cycle loop aligns to this UTC hour.  Leave unset
# for "run every interval starting from container start".
TPOT2CTI_CYCLE_ANCHOR_HOUR_UTC=

# How long to back off after a transient error before the next cycle.
TPOT2CTI_TRANSIENT_RETRY_SECONDS=60

# ===========================================================================
# Importer runtime paths (rarely changed)
# ===========================================================================
# State sqlite DB.  Inside the container.  Compose bind-mounts the
# parent dir from ./data/tpot2cti on the host.
TPOT2CTI_STATE_DB=/data/state.db

# /health endpoint bind address.  Internal-only — NOT mapped to the host.
TPOT2CTI_HEALTH_BIND=0.0.0.0:8080

# ===========================================================================
# Logging
# ===========================================================================
# DEBUG / INFO / WARNING / ERROR.
LOG_LEVEL=INFO

# Where the rotating JSON log file lives inside the container.
# Compose bind-mounts ./logs to this path so logs survive restarts.
LOG_DIR=/var/log/tpot2cti

# Retention for the rotated log files (days).
LOG_RETENTION_DAYS=30

# ===========================================================================
# Compose profiles — opt-in sidecars (V1_SPEC §8)
# ===========================================================================
# Set to a comma-separated list of profiles to enable.  Valid values:
#   credentials   — DuckDB credentials analytics  (V1_SPEC §8.1)
#   vault         — SFTP malware vault            (V1_SPEC §8.2)
# Example: COMPOSE_PROFILES=credentials,vault
COMPOSE_PROFILES=

# ===========================================================================
# Network attachment (V1_SPEC §2)
# ===========================================================================
# The external network name `opencti_default` is hardcoded in
# docker-compose.yml. Previously this section advertised
# OPENCTI_NETWORK_NAME, but the variable was never wired up (audit
# 2026-05-22 #13 confirmed dead). If you've renamed OpenCTI's network,
# edit docker-compose.yml directly — there's no env override.
