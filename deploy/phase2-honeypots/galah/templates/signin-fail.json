  "body": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <meta name=\"robots\" content=\"noindex,nofollow\">\n  <title>Sign in — ExampleCorp</title>\n  <link rel=\"icon\" href=\"/favicon.ico\">\n  <style>\n    *{box-sizing:border-box}\n    body{margin:0;font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Oxygen,Ubuntu,sans-serif;color:#1a1a1a;background:#f7f9fb;line-height:1.55;min-height:100vh;display:flex;flex-direction:column}\n    header{background:#1B5E8C;color:#fff;padding:18px 32px}\n    header .brand{font-weight:700;font-size:20px;letter-spacing:.3px}\n    header .brand span{opacity:.7;margin-left:8px;font-weight:400;font-size:14px}\n    header .brand a{color:#fff;text-decoration:none}\n    main{flex:1;display:flex;align-items:center;justify-content:center;padding:32px 16px}\n    .card{background:#fff;border:1px solid #e5ecf2;border-radius:10px;padding:40px 36px;width:100%;max-width:420px;box-shadow:0 1px 3px rgba(0,0,0,.04)}\n    .card h1{font-size:24px;margin:0 0 6px;letter-spacing:-.3px}\n    .card .sub{color:#7a8896;font-size:14px;margin:0 0 22px}\n    .alert{background:#fef2f2;border:1px solid #fecaca;color:#991b1b;padding:11px 14px;border-radius:6px;font-size:14px;margin-bottom:22px;display:flex;align-items:start;gap:10px}\n    .alert .icon{font-weight:700;font-family:ui-monospace,monospace}\n    .form-row{margin-bottom:18px}\n    label{display:block;font-size:13px;font-weight:600;color:#475560;margin-bottom:6px}\n    input[type=\"email\"],input[type=\"password\"]{width:100%;padding:11px 13px;border:1px solid #d1dae3;border-radius:6px;font-size:15px;background:#fff;transition:border-color .15s,box-shadow .15s}\n    input[type=\"email\"]:focus,input[type=\"password\"]:focus{outline:none;border-color:#1B5E8C;box-shadow:0 0 0 3px rgba(27,94,140,.12)}\n    input.err{border-color:#dc2626}\n    .row-between{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px}\n    .checkbox{display:flex;align-items:center;gap:8px;font-size:14px;color:#475560}\n    .checkbox input{margin:0}\n    .forgot{font-size:14px;color:#1B5E8C;text-decoration:none}\n    .forgot:hover{text-decoration:underline}\n    button{width:100%;background:#1B5E8C;color:#fff;border:0;padding:12px 18px;border-radius:6px;font-size:15px;font-weight:600;cursor:pointer}\n    button:hover{background:#164e75}\n    .divider{display:flex;align-items:center;gap:12px;margin:24px 0;color:#94a3b0;font-size:12px;text-transform:uppercase;letter-spacing:.8px}\n    .divider::before,.divider::after{content:\"\";flex:1;height:1px;background:#e5ecf2}\n    .sso-btn{display:block;width:100%;text-align:center;padding:11px;border:1px solid #d1dae3;border-radius:6px;background:#fff;color:#1a1a1a;text-decoration:none;font-size:14px;font-weight:500;margin-bottom:10px}\n    .sso-btn:hover{background:#f7f9fb}\n    .footnote{text-align:center;color:#7a8896;font-size:13px;margin-top:24px}\n    .footnote a{color:#1B5E8C;text-decoration:none}\n    .env-note{text-align:center;color:#94a3b0;font-size:12px;margin-top:14px}\n    footer{text-align:center;padding:24px 16px;color:#7a8896;font-size:13px;border-top:1px solid #e5ecf2;background:#fff}\n    footer a{color:#1B5E8C;text-decoration:none}\n  </style>\n</head>\n<body>\n  <header>\n    <div class=\"brand\"><a href=\"/\">ExampleCorp</a> <span>⚜ dev dashboard</span></div>\n  </header>\n  <main>\n    <div class=\"card\">\n      <h1>Sign in</h1>\n      <p class=\"sub\">Sign in to your ExampleCorp client dashboard.</p>\n      <div class=\"alert\"><span class=\"icon\">!</span><span><strong>Invalid email or password.</strong> Please try again, or use <a href=\"/dashboard/forgot\" style=\"color:#991b1b;text-decoration:underline\">forgot password</a> if you're locked out.</span></div>\n      <form method=\"POST\" action=\"/dashboard/login\" autocomplete=\"on\">\n        <input type=\"hidden\" name=\"csrf\" value=\"R4mPzN8qXkVbT7hLwYe2\">\n        <input type=\"hidden\" name=\"redirect\" value=\"/dashboard/home\">\n        <div class=\"form-row\">\n          <label for=\"email\">Email</label>\n          <input id=\"email\" name=\"email\" type=\"email\" class=\"err\" required autocomplete=\"username\" placeholder=\"you@company.com\">\n        </div>\n        <div class=\"form-row\">\n          <label for=\"password\">Password</label>\n          <input id=\"password\" name=\"password\" type=\"password\" class=\"err\" required autocomplete=\"current-password\">\n        </div>\n        <div class=\"row-between\">\n          <label class=\"checkbox\"><input type=\"checkbox\" name=\"remember\" value=\"1\"> Remember me</label>\n          <a class=\"forgot\" href=\"/dashboard/forgot\">Forgot password?</a>\n        </div>\n        <button type=\"submit\">Sign in</button>\n      </form>\n      <div class=\"divider\">or continue with</div>\n      <a class=\"sso-btn\" href=\"/dashboard/sso/google\">Continue with Google Workspace</a>\n      <a class=\"sso-btn\" href=\"/dashboard/sso/microsoft\">Continue with Microsoft 365</a>\n      <p class=\"footnote\">Don't have an account? <a href=\"/contact\">Contact your account manager</a>.</p>\n      <p class=\"env-note\">dev.examplecorp.io · build a4f1c8b · req b3f8e1a2</p>\n    </div>\n  </main>\n  <footer>\n    © 2026 ExampleCorp, LLC · <a href=\"/privacy\">Privacy</a> · <a href=\"/terms\">Terms</a>\n  </footer>\n</body>\n</html>\n"
}
