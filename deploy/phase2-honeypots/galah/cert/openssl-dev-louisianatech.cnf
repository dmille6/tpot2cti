[req]
default_bits = 2048
prompt = no
default_md = sha256
distinguished_name = dn
req_extensions = req_ext

[dn]
C = US
ST = Louisiana
L = Baton Rouge
O = LouisianaTech, LLC
OU = Engineering
CN = dev.louisianatech.io

[req_ext]
subjectAltName = @alt_names
keyUsage = critical, digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth

[alt_names]
DNS.1 = dev.louisianatech.io
DNS.2 = *.dev.louisianatech.io
DNS.3 = louisianatech.io
