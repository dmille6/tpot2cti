[req]
default_bits = 2048
prompt = no
default_md = sha256
distinguished_name = dn
req_extensions = req_ext

[dn]
C = US
ST = Louisiana
L = Example City
O = ExampleCo, LLC
OU = Engineering
CN = dev.example.com

[req_ext]
subjectAltName = @alt_names
keyUsage = critical, digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth

[alt_names]
DNS.1 = dev.example.com
DNS.2 = *.dev.example.com
DNS.3 = example.com
